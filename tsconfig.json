{
  "compilerOptions": {
    "lib": [
      "ES2024",
    ],
    "target": "ES2024",
    "module": "commonjs",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server/**/*.ts",
  ],
  "exclude": [
    "node_modules/",
    "tests/**"
  ]
}